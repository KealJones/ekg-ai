{
  "name": "ekg-ai-v0",
  "version": "0.9.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "pnpm build && node scripts/run-tests.mjs fast",
    "ekg": "tsx src/cli/main.ts",
    "ekg:built": "pnpm build && node dist/cli/main.js",
    "start": "pnpm ekg",
    "benchmark:ekg": "pnpm build && node benchmarks/ekgbench.mjs",
