    "benchmark:possession-school": "pnpm build && node benchmarks/v0.8-possession-school.mjs",
    "benchmark:resilience": "pnpm build && node benchmarks/v0.8-resilience.mjs",
    "benchmark:relations-roles-school": "pnpm build && node benchmarks/v0.8-relations-roles-school.mjs",
    "test:experiments": "pnpm build && node scripts/run-tests.mjs experiments",
    "test:ladybug": "pnpm build && node --test tests/ladybug-graph.test.mjs",
    "test:ladybug:integration": "pnpm build && node --test tests/ladybug-integration.test.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "@ladybugdb/core": "^0.19.1"
