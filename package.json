    "benchmark:v0": "pnpm build && node benchmarks/v0-controller.mjs",
    "benchmark:learning": "pnpm build && node benchmarks/v0-learning.mjs",
    "benchmark:report": "pnpm build && node benchmarks/v0-report.mjs",
    "benchmark:promotion": "pnpm build && node benchmarks/v0-promotion.mjs",
    "benchmark:auto-abstraction": "pnpm build && node benchmarks/v0-auto-abstraction.mjs",
    "benchmark:retrieval": "pnpm build && node benchmarks/v0-retrieval.mjs",
    "benchmark:activation": "pnpm build && node benchmarks/v0-activation.mjs",
    "benchmark:teacher-displacement": "pnpm build && node benchmarks/v0-teacher-displacement.mjs",
    "benchmark:intent": "pnpm build && node benchmarks/v0-intent.mjs",
    "benchmark:language-curriculum": "pnpm build && node benchmarks/v0-language-curriculum.mjs",
    "benchmark:filesystem-milestone": "pnpm build && node benchmarks/v0-filesystem-milestone.mjs",
    "benchmark:falsification-pilot": "pnpm build && node benchmarks/v1-falsification-pilot.mjs",
    "benchmark:pilot-audit": "pnpm build && node benchmarks/v1-pilot-audit.mjs",
    "benchmark:tiny-semantic": "pnpm build && node benchmarks/v0-tiny-semantic-probe.mjs",
    "benchmark:v0.3-protocol": "pnpm build && node benchmarks/v0.3-protocol-freeze.mjs",
    "benchmark:v0.3-corpus-audit": "pnpm build && node benchmarks/v0.3-corpus-audit.mjs",
    "benchmark:v0.3-preflight": "pnpm build && node benchmarks/v0.3-denotation-dependency-audit.mjs",
    "benchmark:v0.4-phase0": "pnpm build && node benchmarks/v0.4-phase0.mjs",
    "benchmark:v0.5-phase0": "pnpm build && node benchmarks/v0.5-phase0.mjs",
    "benchmark:portable-play": "pnpm build && node benchmarks/v0.6-portable-play.mjs",
    "benchmark:language-school": "pnpm build && node benchmarks/v0.7-language-school.mjs",
